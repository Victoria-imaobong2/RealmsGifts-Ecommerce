# Copy to .env (local) or add in Vercel → Settings → Environment Variables.
# Never commit real values.

# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (orders, accounts, wishlists, admin products).
DATABASE_URL=""
# Staff password for /login → "Staff" and the /admin dashboard. Use a long random value.
ADMIN_SECRET_KEY=""
# Public site URL, used for payment callbacks, sign-in links, canonical URLs and the sitemap.
NEXT_PUBLIC_APP_URL="https://market-abroad.vercel.app"

# ── Payments (Paystack) ─────────────────────────────────────────────────────
# SECRET key (sk_test_… / sk_live_…). Server-only: never prefix it with NEXT_PUBLIC_.
# Use your test key until the test flow works end to end, then switch to live.
PAYSTACK_SECRET_KEY=
# PUBLIC key (pk_test_… / pk_live_…). Safe for the browser. The current redirect
# checkout doesn't need it; it's reserved for an inline Paystack popup.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Currency your Paystack account charges in. Prices are shown in USD.
# USD requires a USD-enabled Paystack account. If you charge in NGN instead,
# also set PAYSTACK_USD_RATE (NGN per 1 USD) — customers are charged the converted amount.
PAYSTACK_CURRENCY="USD"
PAYSTACK_USD_RATE=
# Development only: point at a mock Paystack server for local testing. Ignored in production.
# PAYSTACK_API_BASE=http://localhost:4010

# ── Email (Resend) — order confirmations and sign-in links ──────────────────
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend.
EMAIL_FROM="Realmsgifts <orders@yourdomain.com>"

# ── Storefront content (all optional; hidden when empty) ───────────────────
NEXT_PUBLIC_ANNOUNCEMENT="Thoughtful gifts. Wherever they are."
# WhatsApp support number, digits only in international format, e.g. 15551234567.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_PINTEREST_URL=""
# Set to "false" once the real product catalogue replaces the starter listings.
NEXT_PUBLIC_SAMPLE_CATALOG="true"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum Role {
  GUEST
  USER
  ADMIN
  SUPPORT
  CUSTOMER
}

enum DeliveryType {
  STANDARD
  EXPRESS
  SAME_DAY
  SCHEDULED
}

// Statuses are only ever recorded by the server (payment verification,
// webhook, or an admin). The customer-facing timeline shows recorded events.
enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY_FOR_DELIVERY
  DISPATCHED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
}

model User {
  id         String         @id @default(cuid())
  email      String         @unique
  name       String?
  password   String?
  role       Role           @default(USER)
  orders     Order[]
  sessions   Session[]
  recipients Recipient[]
  wishlist   WishlistItem[]
  createdAt  DateTime       @default(now())
  updatedAt DateTime @updatedAt
}

// Passwordless sign-in: a single-use, short-lived token emailed to the user.
// Only a SHA-256 hash of the token is stored.
model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Recipient {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname     String
  firstName    String
  lastName     String
  phone        String?
  country      String
  line1        String
  line2        String?
  city         String
  region       String?
  postalCode   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productSlug String
  createdAt   DateTime @default(now())

  @@unique([userId, productSlug])
}

model Product {
  id          String           @id @default(cuid())
  slug        String?          @unique
  category    String?
  title       String
  description String
  price       Float
  stock       Int              @default(0)
  images      String[]
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String?
  size      String?
  stock     Int     @default(0)
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String?      @unique
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])
  email           String?
  customerName    String?
  customerPhone   String?
  status          OrderStatus  @default(PENDING)
  currency        String       @default("Naira")
  subtotal        Float?
  shippingFee     Float?
  giftWrapFee     Float?
  total           Float
  deliveryType    DeliveryType @default(STANDARD)
  deliveryDate    DateTime?
  destination     String?
  items           Json?
  shippingAddress Json?
  gift            Json?
  // Amount and currency actually sent to Paystack (minor units), used to
  // verify the payment server-side.
  chargeAmount    Int?
  chargeCurrency  String?
  paidAt          DateTime?
  podSignature    String?
  paymentRef      String?      @unique
  // Idempotency key sent by the checkout page: a repeated submit returns the
  // same Paystack checkout instead of creating a second order.
  checkoutKey     String?      @unique
  authorizationUrl String?
  // Last status reported by Paystack's verify API (success, failed, abandoned…).
  gatewayStatus   String?
  events          OrderEvent[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  @@index([email])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
